# provider credentials — sourced by deploy.sh and exported for the tofu providers.
# copy to .env (gitignored) and fill in.

# Hetzner Cloud API token (project -> security -> api tokens, read/write)
HCLOUD_TOKEN=

# Cloudflare API token (my profile -> api tokens). needs: Zone:DNS:Edit,
# Account:Cloudflare Pages:Edit (used by both tofu and the wrangler frontend deploy).
CLOUDFLARE_API_TOKEN=

# (account id + zone id are discovered by tofu from the domain name — no need to
#  set them here. override the domain via TF_VAR_cloudflare_zone_name if not gatho.dev.)

# email Caddy uses for Let's Encrypt registration on the box
ACME_EMAIL=
