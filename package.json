{
    "name": "gatho",
    "version": "0.0.0-alpha-1",
    "author": "Isaac Mason <isaac@isaacmason.com>",
    "description": "javascript multiplayer toolkit for building real-time games and applications",
    "keywords": [
        "multiplayer",
        "websocket"
    ],
    "license": "MIT",
    "repository": "github:isaac-mason/gatho",
    "homepage": "https://github.com/isaac-mason/gatho",
    "bugs": {
        "url": "https://github.com/isaac-mason/gatho/issues"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./server": {
            "import": "./dist/server.js",
            "types": "./dist/src/server/index.d.ts"
        },
        "./room": {
            "import": "./dist/room.js",
            "types": "./dist/src/room/index.d.ts"
        },
        "./driver": {
            "import": "./dist/driver.js",
            "types": "./dist/src/driver/index.d.ts"
        },
        "./common": {
            "import": "./dist/common.js",
            "types": "./dist/src/common/index.d.ts"
        },
        "./client": {
            "import": "./dist/client.js",
            "types": "./dist/src/client/index.d.ts"
        },
        "./sdk": {
            "import": "./dist/sdk.js",
            "types": "./dist/src/sdk/index.d.ts"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "rm -rf ./dist && rollup --config rollup.config.mjs",
        "format": "biome format --write src/. docs/src/.",
        "lint": "biome lint --write src/. docs/src/.",
        "test": "./tst/release.sh",
        "test:unit": "cd tst && ./unit.sh",
        "test:integration": "cd tst && ./integration.sh",
        "test:types": "cd tst && ./types.sh",
        "test:browser": "cd tst && ./browser.sh",
        "test:e2e": "cd tst && ./e2e.sh",
        "typecheck-docs": "tsc --project docs/tsconfig.json --noEmit",
        "docs": "(cd docs && node ./build.js)",
        "typedoc": "typedoc --tsconfig ./tsconfig.json --name \"gatho docs\" --out ./dist-typedoc ./sdk/index.ts ./room/index.ts ./server/index.ts ./driver/index.ts ./client/index.ts ./common/index.ts"
    },
    "packageManager": "pnpm@8.15.2+sha1.798034f615aa211c6c2ae00010cc20be5fc102ee",
    "dependencies": {
        "ioredis": "^5.10.1",
        "packcat": "0.3.0",
        "postgres": "^3.4.9",
        "ws": "^8.20.0"
    },
    "peerDependenciesMeta": {},
    "devDependencies": {
        "@biomejs/biome": "^2.4.12",
        "@playwright/test": "^1.59.1",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/bun": "^1.3.12",
        "@types/node": "^25.6.0",
        "@types/ws": "^8.18.1",
        "rollup": "^4.60.1",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-filesize": "^10.0.0",
        "tslib": "^2.8.1",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.2",
        "vitest": "^4.1.4"
    }
}
