{
    "name": "gatho",
    "version": "0.0.0-alpha-3",
    "author": "Isaac Mason <isaac@isaacmason.com>",
    "description": "javascript multiplayer toolkit for building real-time games and applications",
    "keywords": [
        "multiplayer",
        "websocket"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/isaac-mason/gatho.git"
    },
    "homepage": "https://github.com/isaac-mason/gatho",
    "bugs": {
        "url": "https://github.com/isaac-mason/gatho/issues"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./server": {
            "import": "./dist/server.js",
            "types": "./dist/server/index.d.ts"
        },
        "./room": {
            "import": "./dist/room.js",
            "types": "./dist/room/index.d.ts"
        },
        "./driver": {
            "import": "./dist/driver.js",
            "types": "./dist/driver/index.d.ts"
        },
        "./driver/redis": {
            "import": "./dist/driver-redis.js",
            "types": "./dist/driver/redis.d.ts"
        },
        "./client": {
            "import": "./dist/client.js",
            "types": "./dist/client/index.d.ts"
        },
        "./sdk": {
            "import": "./dist/sdk.js",
            "types": "./dist/sdk/index.d.ts"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "rm -rf ./dist && rollup --config rollup.config.mjs",
        "format": "biome format --write src/. docs/src/.",
        "lint": "biome lint --write src/. docs/src/.",
        "test": "./tst/release.sh",
        "test:unit": "cd tst && ./unit.sh",
        "test:integration": "cd tst && ./integration.sh",
        "test:types": "cd tst && ./types.sh",
        "test:browser": "cd tst && ./browser.sh",
        "test:e2e": "cd tst && ./e2e.sh",
        "typecheck-docs": "tsc --project docs/tsconfig.json --noEmit",
        "docs": "(cd docs && node ./build.js)",
        "typedoc": "typedoc --tsconfig ./tsconfig.json --name \"gatho docs\" --out ./dist-typedoc ./src/sdk/index.ts ./src/room/index.ts ./src/server/index.ts ./src/driver/index.ts ./src/driver/redis.ts ./src/client/index.ts"
    },
    "packageManager": "pnpm@12.21.0",
    "dependencies": {
        "packcat": "0.4.0",
        "ws": "^8.23.0"
    },
    "peerDependencies": {
        "ioredis": "^5.10.1 || ^6.0.0"
    },
    "peerDependenciesMeta": {
        "ioredis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@playwright/test": "^1.65.1",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "@types/ws": "^8.18.2",
        "ioredis": "^6.0.0",
        "rollup": "^4.68.8",
        "rollup-plugin-copy": "^3.5.0",
        "tslib": "^2.9.1",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1"
    }
}
